<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MVP requires NO intrusive permissions (no SMS, background location, contacts, camera) -->
    <!-- Internet only needed for future network calls / remote map tiles if used -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".GlipDriverApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GlipDriver">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GlipDriver"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- In-App Crash Diagnostic Activity running in an isolated reporter process -->
        <activity
            android:name=".ui.crash.CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.GlipDriver"
            android:process=":crash_reporter" />
    </application>

</manifest>
